# NexChat Environment Variables Template

# Application Ports
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000/api/v1
NEXT_PUBLIC_SOCKET_URL=http://localhost:4000

# PostgreSQL Database Connection
DATABASE_URL="postgresql://nexchat:nexchat_password@localhost:5432/nexchat_db?schema=public"

# Redis Cache & Pub/Sub
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT Secrets
JWT_ACCESS_SECRET="nexchat_super_secret_access_key_2026_change_in_production"
JWT_REFRESH_SECRET="nexchat_super_secret_refresh_key_2026_change_in_production"
JWT_ACCESS_EXPIRATION="15m"
JWT_REFRESH_EXPIRATION="7d"

# Cloudflare R2 / S3 Object Storage (Phase 2)
R2_ACCOUNT_ID=""
R2_ACCESS_KEY_ID=""
R2_SECRET_ACCESS_KEY=""
R2_BUCKET_NAME="nexchat-media"
R2_PUBLIC_DOMAIN="https://cdn.nexchat.io"

# OAuth Credentials (Optional)
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
